#!/usr/bin/env bash
set -euo pipefail

# Publish a build of this checkout's committed revision.
version=$(python3 -c 'from version import VERSION; print(VERSION)')
revision=$(git rev-parse HEAD)
image=${AI_TOOLKIT_IMAGE:-ghcr.io/bliponnobodysradar/ai-toolkit}
docker build --build-arg "GIT_COMMIT=$revision" -t "$image:$version" -t "$image:latest" -f docker/Dockerfile .
docker push "$image:$version"
docker push "$image:latest"
